# ==============================================================================
# DTG Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.

# Database
DB_NAME=dtg
DB_USER=dtg_user
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
# Staging/production must use distinct owner and runtime credentials.
DB_OWNER_USER=dtg_owner
DB_OWNER_PASSWORD=CHANGE_ME_TO_A_DISTINCT_OWNER_PASSWORD
DB_APP_USER=dtg_app
DB_APP_PASSWORD=CHANGE_ME_TO_A_DISTINCT_APP_PASSWORD

# Network
PORT=3000
DTG_LOCAL_PROJECT_NAME=antygravity
DTG_STAGING_PROJECT_NAME=dtg-voting-staging
DTG_PRODUCTION_PROJECT_NAME=dtg-voting-production
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=3001
BIOMETRIC_HOST_PORT=8001
SHIELD_HOST_PORT=8080
ADMIN_HOST_PORT=5173
# Staging uses a separate project name and these host ports.
STAGING_POSTGRES_HOST_PORT=15432
STAGING_REDIS_HOST_PORT=16379
STAGING_BACKEND_HOST_PORT=13001
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
# Shield trusts forwarding headers only from these explicit proxy CIDRs.
TRUSTED_PROXY_CIDRS=

# Security (HS256 Secrets)
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_BYTES
PN_HASH_SECRET=CHANGE_ME_TO_RANDOM_64_BYTES
API_KEY_ENCRYPTION_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES_FOR_AES
DEVICE_HASH_SECRET=CHANGE_ME_TO_RANDOM_64_BYTES
VOTER_HASH_SECRET=CHANGE_ME_TO_RANDOM_64_BYTES

# Blockchain
# Use a private key that does NOT hold significant funds in production
BLOCKCHAIN_PRIVATE_KEY=0x_CHANGE_ME_TO_SECURE_PRIVATE_KEY
BLOCKCHAIN_RPC_ALLOWED_HOSTS=rpc.example.ge
REWARD_PROCESSOR_ENABLED=false
POLL_STATUS_MONITOR_ENABLED=false
VOTE_ANCHOR_ENABLED=false

# ZK Nullifier
NULLIFIER_SECRET=CHANGE_ME_TO_RANDOM_64_BYTES

# Admin
ADMIN_PASSWORD=CHANGE_ME_SECURE_ADMIN_PASS
ADMIN_MFA_REQUIRED=false
ADMIN_SESSION_IDLE_SECONDS=900
ADMIN_SESSION_ABSOLUTE_SECONDS=28800
ADMIN_MAX_CONCURRENT_SESSIONS=3
ENFORCE_RESTRICTED_DB_ROLE=false
METRICS_BEARER_TOKEN=

# Signed external audit checkpoints (off locally; mandatory in production).
AUDIT_CHECKPOINT_ENABLED=false
AUDIT_CHECKPOINT_URL=
AUDIT_CHECKPOINT_ALLOWED_HOSTS=
AUDIT_CHECKPOINT_DEPLOYMENT_ID=dtg-local
AUDIT_CHECKPOINT_INTERVAL_SECONDS=300
AUDIT_CHECKPOINT_PRIVATE_KEY_PEM=
AUDIT_CHECKPOINT_PUBLIC_KEY_PEM=
AUDIT_CHECKPOINT_BEARER_TOKEN=

# Production mobile integrity verification
REQUIRE_DEVICE_ATTESTATION=false
ALLOW_DEVELOPMENT_ATTESTATION_BYPASS=false
# Public numeric Google Cloud project number used by the Android Standard API.
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
ANDROID_PACKAGE_NAME=messaging.dtg
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
APPLE_DEVICECHECK_KEY_ID=
APPLE_DEVICECHECK_TEAM_ID=
APPLE_DEVICECHECK_PRIVATE_KEY=
# App Attest request-bound verification (App ID prefix may differ from Team ID
# for older Apple developer accounts).
APPLE_APP_ID_PREFIX=
APPLE_BUNDLE_ID=ge.dtfg.mobile
APPLE_APP_ATTEST_ENVIRONMENT=development
APPLE_APP_ATTEST_REQUIRE_EXTENSIONS=true
APPLE_APP_ATTEST_ALLOWED_CATEGORIES=2,3,4
APPLE_APP_BUNDLE_VERSION=1
RECEIPT_PRIVATE_KEY_PEM=
RECEIPT_PUBLIC_KEY_PEM=

# Production secret-manager authentication. Prefer a renewable Vault Agent or
# workload-identity token mounted as a read-only file.
VAULT_REQUIRED=false
VAULT_ADDR=
VAULT_TOKEN_FILE=
VAULT_SECRET_PATH=secret/data/dtg
