#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"
// MLKitVision 10 / MLKitCommon 14 provide only x86_64 simulator slices.
// Keep Runner compatible with Pods on the first build of a clean checkout,
// before Flutter can inspect the generated Pods project for excluded arches.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = $(inherited) arm64
APP_ATTEST_ENVIRONMENT=development
